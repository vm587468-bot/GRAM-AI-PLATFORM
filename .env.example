# GEMINI_API_KEY: Required for Gemini AI assistant & voice copilot calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DATA_GOV_API_KEY: Optional API key from data.gov.in for live Agmarknet mandi price sync.
# When omitted, the Market section uses the verified reference dataset and labels it transparently.
DATA_GOV_API_KEY=""

# AUTH_SECRET: Optional secret for signing session bearer tokens.
AUTH_SECRET=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
